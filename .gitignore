
# ==========================================
# CAFÉ Tourism Data Pipeline
# Git ignore configuration
# ==========================================

# Python virtual environments
.venv/
venv/
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Private notes and working journals
journal/
**/journal/

# Word documents
*.doc
*.docx
~$*

# Downloaded and generated datasets
data/raw/
data/processed/
data/interim/

# Generated outputs and reports
outputs/
*.xlsx
*.xls

# Images and screenshots
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.bmp
*.tiff

# PDF documents
*.pdf

# Temporary and cache files
.cache/
.pytest_cache/
.ipynb_checkpoints/
*.tmp
*.log

# Jupyter and Python tools
.ruff_cache/
.mypy_cache/

# Operating systems and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build files
dist/
build/
*.egg-info/
